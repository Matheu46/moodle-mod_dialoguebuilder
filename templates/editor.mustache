    Editor template for mod_dialoguebuilder.

    Example context (json):
    {
        "cmid": 12,
        "initialdata": "{\"characters\":[],\"lines\":[]}",
        "sesskey": "aBcDeFgHiJ"
    }
}}

<div class="mod-dialoguebuilder__editor-wrapper position-relative" id="mod-dialoguebuilder__editor-{{cmid}}" data-initialdata="{{initialdata}}">
    <!-- Emoji Picker Container -->
    <div id="mod-dialoguebuilder__emoji-picker-container" class="position-absolute d-none" style="z-index: 1050; max-width: 350px; background: white; border-radius: 8px;">
        {{> core/emoji/picker }}
    </div>

    <form action="edit.php" method="POST" id="mod-dialoguebuilder__submit-form" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="dialoguedata" id="mod-dialoguebuilder__dialoguedata">

        <div class="row">
        <!-- Sidebar for Characters -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h4 class="h5 mb-0">{{#str}} characters, mod_dialoguebuilder {{/str}}</h4>
                </div>
                <div class="card-body">
                    <ul id="mod-dialoguebuilder__character-list" class="list-group mb-3">
                        <!-- Characters injected by JS -->
                    </ul>
                    <button id="mod-dialoguebuilder__add-char-btn" class="btn btn-secondary w-100">
                        <i class="fa fa-user-plus" aria-hidden="true"></i> {{#str}} addcharacter, mod_dialoguebuilder {{/str}}
                    </button>
                </div>
            </div>
        </div>

        <!-- Main pane for Dialogue -->
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="h5 mb-0">{{#str}} dialoguescript, mod_dialoguebuilder {{/str}}</h4>
                    <button id="mod-dialoguebuilder__add-line-btn" class="btn btn-primary btn-sm" disabled>
                        <i class="fa fa-comment-plus" aria-hidden="true"></i> + {{#str}} addline, mod_dialoguebuilder {{/str}}
                    </button>
                </div>
                <div class="card-body" id="mod-dialoguebuilder__dialogue-lines" style="max-height: 700px; overflow-y: auto;">
                    <!-- Dialogue lines injected by JS -->
                    <div class="alert alert-info text-center" id="mod-dialoguebuilder__empty-lines-msg">
                        {{#str}} emptylinesmsg, mod_dialoguebuilder {{/str}}
                    </div>
                </div>
            </div>

            <!-- Submission Actions -->
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="view.php?id={{cmid}}" class="btn btn-outline-secondary">{{#str}} cancel, core {{/str}}</a>
                {{^is_submitted}}
                <button type="submit" name="action" value="save_draft" class="btn btn-outline-primary" id="mod-dialoguebuilder__save-draft-btn">
                    <i class="fa fa-save" aria-hidden="true"></i> {{#str}} savedraft, mod_dialoguebuilder {{/str}}
                </button>
                <button type="submit" name="action" value="submit" class="btn btn-success" id="mod-dialoguebuilder__submit-btn">
                    <i class="fa fa-paper-plane" aria-hidden="true"></i> {{#str}} submittask, mod_dialoguebuilder {{/str}}
                </button>
                {{/is_submitted}}
                {{#is_submitted}}
                <button type="submit" name="action" value="submit" class="btn btn-success" id="mod-dialoguebuilder__submit-btn">
                    <i class="fa fa-save" aria-hidden="true"></i> {{#str}} savechanges, core {{/str}}
                </button>
                {{/is_submitted}}
            </div>
        </div>
    </div>
    </form>
</div>
