<div class="mod-dialoguebuilder__editor-wrapper" id="mod-dialoguebuilder__editor-{{cmid}}" data-initialdata="{{initialdata}}">
    <form action="edit.php" method="POST" id="mod-dialoguebuilder__submit-form" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="action" value="save">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="dialoguedata" id="mod-dialoguebuilder__dialoguedata">

        <div class="row">
        <!-- Sidebar for Characters -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h4 class="h5 mb-0">{{#str}} characters, mod_dialoguebuilder {{/str}}</h4>
                </div>
                <div class="card-body">
                    <ul id="mod-dialoguebuilder__character-list" class="list-group mb-3">
                        <!-- Characters injected by JS -->
                    </ul>
                    <button id="mod-dialoguebuilder__add-char-btn" class="btn btn-secondary w-100">
                        <i class="fa fa-user-plus" aria-hidden="true"></i> {{#str}} addcharacter, mod_dialoguebuilder {{/str}}
                    </button>
                </div>
            </div>
        </div>

        <!-- Main pane for Dialogue -->
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="h5 mb-0">{{#str}} dialoguescript, mod_dialoguebuilder {{/str}}</h4>
                    <button id="mod-dialoguebuilder__add-line-btn" class="btn btn-primary btn-sm" disabled>
                        <i class="fa fa-comment-plus" aria-hidden="true"></i> + {{#str}} addline, mod_dialoguebuilder {{/str}}
                    </button>
                </div>
                <div class="card-body" id="mod-dialoguebuilder__dialogue-lines">
                    <!-- Dialogue lines injected by JS -->
                    <div class="alert alert-info text-center" id="mod-dialoguebuilder__empty-lines-msg">
                        {{#str}} emptylinesmsg, mod_dialoguebuilder {{/str}}
                    </div>
                </div>
            </div>

            <!-- Submission Actions -->
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="view.php?id={{cmid}}" class="btn btn-outline-secondary">{{#str}} cancel, core {{/str}}</a>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save" aria-hidden="true"></i> {{#str}} savescript, mod_dialoguebuilder {{/str}}
                </button>
            </div>
        </div>
    </div>
    </form>
</div>
