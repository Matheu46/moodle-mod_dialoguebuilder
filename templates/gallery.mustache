    Example context (json):
    {
        "cards": [
            {
                "authorname": "John Doe",
                "avatarurl": "https://moodle.site/u/f2",
                "preview": "Hello, how are you?",
                "viewurl": "https://moodle.site/mod/dialoguebuilder/view_submission.php?id=1&subid=2"
            }
        ]
    }
}}

<div class="mod-dialoguebuilder-gallery row mt-4">
    {{#cards}}
    <div class="col-12 col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="d-flex justify-content-center mb-3">
                    {{#avatars}}
                    <img src="{{url}}" alt="Avatar" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover; {{#is_second}}margin-left: -20px; border: 2px solid #fff; position: relative; z-index: 1;{{/is_second}}{{^is_second}}position: relative; z-index: 2;{{/is_second}}">
                    {{/avatars}}
                </div>
                <h5 class="card-title">{{authorname}}</h5>
                {{#preview}}
                <p class="card-text text-muted font-italic">"{{preview}}"</p>
                {{/preview}}
                {{^preview}}
                <p class="card-text text-muted font-italic">{{#str}} nolinesrecorded, mod_dialoguebuilder {{/str}}</p>
                {{/preview}}
            </div>
            <div class="card-footer bg-white border-top-0 text-center">
                <a href="{{viewurl}}" class="btn btn-primary w-100">{{#str}} viewdialogue, mod_dialoguebuilder {{/str}}</a>
            </div>
        </div>
    </div>
    {{/cards}}
</div>
